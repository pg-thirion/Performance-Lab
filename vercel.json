{
  "rewrites": [
    {
      "source": "/data/benchmarks",
      "destination": "https://opengpubenchmarks.com/api/v1/dashboard.json"
    },
    {
      "source": "/data/steam-deck",
      "destination": "https://raw.githubusercontent.com/xpressmike/steamos-playability-dataset/main/steamfps-games.csv"
    },
    {
      "source": "/data/pc-estimates",
      "destination": "https://raw.githubusercontent.com/emilioagustin83/pc-game-fps-dataset/main/data/games.csv"
    },
    {
      "source": "/data/techfuel",
      "destination": "https://techfuelhq.com/data/gpu/rog-astral-rtx-5080-oc-2026-06-09/dataset.json"
    },
    {
      "source": "/data/techfuel-telemetry",
      "destination": "https://techfuelhq.com/data/gpu/rog-astral-rtx-5080-oc-2026-06-09/sustained-gaming-telemetry-2026-06-28.csv"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https:; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    }
  ]
}
